// ============================================================================
// ShopSphere — Prisma Database Schema (PostgreSQL)
// ============================================================================
// Key Rules Enforced in Schema:
// 1. All monetary values are stored as integer paise (₹1.00 = 100 paise).
// 2. Historical orders snapshot product prices/names and shipping addresses so
//    later updates to catalog items or saved addresses never alter past invoices.
// 3. Financial records (Orders, OrderItems) use Restrict on delete to prevent
//    accidental data loss of audit/accounting history.
// 4. Composite unique constraints prevent duplicate cart items, wishlist items,
//    and multiple reviews by the same user on the same product.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum DiscountType {
  PERCENTAGE
  FIXED_PAISE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryReason {
  INITIAL_STOCK
  ORDER_RESERVED
  ORDER_CANCELLED
  ADMIN_ADJUSTMENT
  DAMAGED_OR_LOST
}

// ----------------------------------------------------------------------------
// 1. Users, Authentication & Addresses
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(120)
  phone        String?  @db.VarChar(20)
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  addresses           Address[]
  cart                Cart?
  wishlistItems       WishlistItem[]
  orders              Order[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  inventoryLogs       InventoryLog[]       @relation("InventoryActor")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String   @default("Home") @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(20)
  line1         String   @db.VarChar(255)
  line2         String?  @db.VarChar(255)
  landmark      String?  @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(10) // 6-digit Indian PIN code
  country       String   @default("IN") @db.VarChar(2)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

// ----------------------------------------------------------------------------
// 2. Catalog: Categories, Products, Images & Inventory Audit Logs
// ----------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Self-relation for optional category hierarchy
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  // Relations
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  sku               String   @unique @db.VarChar(64)
  name              String   @db.VarChar(200)
  slug              String   @unique @db.VarChar(220)
  shortDescription  String?  @map("short_description") @db.VarChar(500)
  description       String   @db.Text
  brand             String?  @db.VarChar(100)
  pricePaise        Int      @map("price_paise") // Selling price in integer paise
  mrpPaise          Int      @map("mrp_paise") // Maximum Retail Price in integer paise (>= pricePaise)
  stockQuantity     Int      @default(0) @map("stock_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  isFeatured        Boolean  @default(false) @map("is_featured")
  specifications    Json?    @db.JsonB
  averageRating     Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount       Int      @default(0) @map("review_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  inventoryLogs InventoryLog[]

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@index([pricePaise])
  @@index([createdAt])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  url          String   @db.VarChar(500)
  altText      String?  @map("alt_text") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

model InventoryLog {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  orderId        String?         @map("order_id") @db.Uuid
  changeQuantity Int             @map("change_quantity")
  previousStock  Int             @map("previous_stock")
  newStock       Int             @map("new_stock")
  reason         InventoryReason
  notes          String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at")

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorUser User?   @relation("InventoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("inventory_logs")
}

// ----------------------------------------------------------------------------
// 3. Shopping Cart, Wishlist & Coupons
// ----------------------------------------------------------------------------

model Coupon {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique @db.VarChar(50) // Stored uppercase (e.g., WELCOME10)
  description      String?      @db.VarChar(255)
  discountType     DiscountType @map("discount_type")
  discountValue    Int          @map("discount_value") // Percentage (1-100) or Fixed amount in paise
  minOrderPaise    Int          @default(0) @map("min_order_paise")
  maxDiscountPaise Int?         @map("max_discount_paise") // Optional cap in paise for percentage coupons
  usageLimit       Int?         @map("usage_limit")
  perUserLimit     Int          @default(1) @map("per_user_limit")
  usedCount        Int          @default(0) @map("used_count")
  startsAt         DateTime     @map("starts_at")
  expiresAt        DateTime     @map("expires_at")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  carts  Cart[]
  orders Order[]

  @@index([code, isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model Cart {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  appliedCouponId String?  @map("applied_coupon_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedCoupon Coupon?    @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)
  items         CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

// ----------------------------------------------------------------------------
// 4. Orders, Order Items & Payments
// ----------------------------------------------------------------------------

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderNumber        String        @unique @map("order_number") @db.VarChar(40) // e.g., SS-20261019-A1B2C3
  userId             String        @map("user_id") @db.Uuid
  couponId           String?       @map("coupon_id") @db.Uuid
  couponCodeSnapshot String?       @map("coupon_code_snapshot") @db.VarChar(50)
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  subtotalPaise      Int           @map("subtotal_paise")
  discountPaise      Int           @default(0) @map("discount_paise")
  shippingPaise      Int           @default(0) @map("shipping_paise")
  taxPaise           Int           @default(0) @map("tax_paise")
  totalPaise         Int           @map("total_paise")
  currency           String        @default("INR") @db.VarChar(3)

  // Immutable Shipping Address Snapshot at time of checkout
  shippingRecipientName String  @map("shipping_recipient_name") @db.VarChar(120)
  shippingPhone         String  @map("shipping_phone") @db.VarChar(20)
  shippingLine1         String  @map("shipping_line1") @db.VarChar(255)
  shippingLine2         String? @map("shipping_line2") @db.VarChar(255)
  shippingLandmark      String? @map("shipping_landmark") @db.VarChar(255)
  shippingCity          String  @map("shipping_city") @db.VarChar(100)
  shippingState         String  @map("shipping_state") @db.VarChar(100)
  shippingPostalCode    String  @map("shipping_postal_code") @db.VarChar(10)
  shippingCountry       String  @default("IN") @map("shipping_country") @db.VarChar(2)

  notes              String?   @db.VarChar(500)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)
  cancelledAt        DateTime? @map("cancelled_at")
  deliveredAt        DateTime? @map("delivered_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  reviews       Review[]
  inventoryLogs InventoryLog[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  productNameSnapshot  String   @map("product_name_snapshot") @db.VarChar(200)
  productSkuSnapshot   String   @map("product_sku_snapshot") @db.VarChar(64)
  productImageSnapshot String?  @map("product_image_snapshot") @db.VarChar(500)
  unitPricePaise       Int      @map("unit_price_paise")
  unitMrpPaise         Int      @map("unit_mrp_paise")
  quantity             Int
  lineTotalPaise       Int      @map("line_total_paise")
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider @default(MOCK)
  status            PaymentStatus   @default(PENDING)
  amountPaise       Int             @map("amount_paise")
  currency          String          @default("INR") @db.VarChar(3)
  providerOrderId   String?         @unique @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(120)
  providerSignature String?         @map("provider_signature") @db.VarChar(255)
  method            String?         @db.VarChar(50)
  failureReason     String?         @map("failure_reason") @db.VarChar(500)
  webhookEventId    String?         @unique @map("webhook_event_id") @db.VarChar(120)
  rawPayload        Json?           @map("raw_payload") @db.JsonB
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// 5. Product Reviews & Moderation
// ----------------------------------------------------------------------------

model Review {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  orderId            String?      @map("order_id") @db.Uuid
  rating             Int          // Validated 1..5 in Zod + DB check constraint in migration
  title              String?      @db.VarChar(150)
  comment            String       @db.Text
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  status             ReviewStatus @default(PENDING)
  adminNotes         String?      @map("admin_notes") @db.VarChar(500)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status])
  @@map("reviews")
}
