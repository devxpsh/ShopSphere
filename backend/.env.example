# ============================================================================
# ShopSphere Backend — Environment Configuration Example
# Copy this file to backend/.env for local development.
# NEVER commit real secrets to version control.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopsphere?schema=public"

# Authentication & Cookie Security
# Generate a strong random secret in production (e.g., `openssl rand -hex 32`)
JWT_ACCESS_SECRET="replace-with-at-least-32-char-random-access-secret-key"
JWT_REFRESH_SECRET="replace-with-at-least-32-char-random-refresh-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CSRF_SECRET="replace-with-at-least-32-char-random-csrf-secret-key"
COOKIE_SECURE=false

# Payment Provider Configuration ("MOCK" | "RAZORPAY")
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Development Seed Credentials (Only active when NODE_ENV !== 'production')
SEED_ADMIN_EMAIL="admin@shopsphere.in"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_CUSTOMER_EMAIL="aarav.sharma@example.in"
SEED_CUSTOMER_PASSWORD="CustomerPassword123!"
